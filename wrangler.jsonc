{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "restaurant-platform-test",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurant-platform",
      "database_id": "ed0a6041-9235-495d-8106-a6c642a41c2c",
      "migrations_dir": "database/d1/migrations"
    },
    {
      "binding": "DEMO_DB",
      "database_name": "restaurant-platform-preview",
      "database_id": "98846bad-cd3e-4770-8bee-2076774885e6",
      "migrations_dir": "database/d1/migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "OIDC_ISSUER": "https://dev-iamsatheeshgkotegar.us.auth0.com/",
    "OIDC_AUDIENCE": "https://platform-core-api",
    "OIDC_JWKS_URL": "https://dev-iamsatheeshgkotegar.us.auth0.com/.well-known/jwks.json",
    "OIDC_CLIENT_ID": "PZuFV2NqKcO0yVvwTIHNWSkt8EWl19CX"
  },
  "triggers": { "crons": ["0 3 * * *"] },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "restaurant-platform-preview",
        "database_id": "98846bad-cd3e-4770-8bee-2076774885e6",
        "migrations_dir": "database/d1/migrations"
      },
      {
        "binding": "DEMO_DB",
        "database_name": "restaurant-platform-preview",
        "database_id": "98846bad-cd3e-4770-8bee-2076774885e6",
        "migrations_dir": "database/d1/migrations"
      }
    ],
    "vars": {
      "ENVIRONMENT": "preview",
      "DEMO_OWNER_LOGIN_ID": "demo.owner",
      "OIDC_ISSUER": "https://dev-iamsatheeshgkotegar.us.auth0.com/",
      "OIDC_AUDIENCE": "https://platform-core-api",
      "OIDC_JWKS_URL": "https://dev-iamsatheeshgkotegar.us.auth0.com/.well-known/jwks.json",
      "OIDC_CLIENT_ID": "PZuFV2NqKcO0yVvwTIHNWSkt8EWl19CX"
    }
  }
}
