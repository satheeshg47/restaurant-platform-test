      "migrations_dir": "database/d1/migrations"
    },
    {
      "binding": "DEMO_DB",
      "database_name": "restaurant-platform-preview-demo",
      "database_id": "5e4f9a4d-effe-4047-895a-79c778a1f3cf",
      "migrations_dir": "database/d1/migrations"
    }
  ]
}
